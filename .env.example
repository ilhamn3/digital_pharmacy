# Application Environment
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
# Migrations and administrative scripts connect as the database owner
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5433/pharmacy_pos

# Application API pool connects as the non-owner, least-privileged role (pharmacy_app)
DATABASE_URL=postgres://pharmacy_app:pharmacy_app_pass@localhost:5433/pharmacy_pos
APP_DB_PASSWORD=pharmacy_app_pass

DB_HOST=localhost
DB_PORT=5433
DB_USER=pharmacy_app
DB_PASSWORD=pharmacy_app_pass
DB_NAME=pharmacy_pos

# Proxy configuration (set to 1 / true when behind reverse proxy)
TRUST_PROXY=

# Authentication Secrets
JWT_ACCESS_SECRET=pharmacy_dev_access_secret_key_minimum_32_characters_long_for_security
JWT_REFRESH_SECRET=pharmacy_dev_refresh_secret_key_minimum_32_characters_long_for_security
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Pharmacy / Regional Configuration
TIMEZONE=Asia/Colombo
CURRENCY=LKR

