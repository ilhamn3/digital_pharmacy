# Application Environment
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/pharmacy_pos
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=pharmacy_pos

# Authentication Secrets
JWT_ACCESS_SECRET=pharmacy_dev_access_secret_key_minimum_32_characters_long_for_security
JWT_REFRESH_SECRET=pharmacy_dev_refresh_secret_key_minimum_32_characters_long_for_security
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Pharmacy / Regional Configuration
TIMEZONE=Asia/Colombo
CURRENCY=LKR

